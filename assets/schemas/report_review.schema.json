{
 "title": "原典照合の報告（レビュー担当が書く）",
 "file": "reports/review_<フローID>[_<分冊>].json・review_<フローID>_差分<N>.json",
 "description": "作り方を知らない別のエージェントが書く。親は、これを機械で採否表（review/<フローID>.review.json）の下書きに写し、採否と対応だけを書く",
 "type": "object",
 "additionalProperties": false,
 "required": ["verdicts", "findings"],
 "properties": {
  "sheet": {"$ref": "common#/$defs/sheet_id", "description": "照合したシートの番号（シートの見出しの［S-3］を写す）。新しい報告には必ず書く（無ければ門が FAIL。無くてよいのは、前の版の報告だけ）。どの版の図を照合したかは、この番号で決まる"},
  "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}, "description": "開始・終了を除く全ノードの判定（差分照合の報告は、シートに載った箱だけ）"},
  "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}, "description": "指摘。無ければ空"}
 },
 "$defs": {
  "verdict": {
   "title": "verdicts[]",
   "type": "object",
   "additionalProperties": false,
   "required": ["node", "verdict", "evidence"],
   "properties": {
    "node": {"$ref": "common#/$defs/flow_node_id"},
    "verdict": {"enum": ["支持", "一部支持", "不支持"]},
    "evidence": {"type": "string", "description": "原典の該当箇所の引用（不支持・一部支持は、何が違うかを1文で添える）"}
   }
  },
  "finding": {
   "title": "findings[]",
   "type": "object",
   "additionalProperties": false,
   "required": ["kind", "target", "text"],
   "properties": {
    "kind": {"enum": ["一部支持", "不支持", "抜け", "つなぎ", "表記"]},
    "target": {"type": "string", "minLength": 1, "description": "ノード・線・ページ（ページは照合シートの見出しの書き方で）"},
    "text": {"type": "string", "minLength": 1, "description": "何が違うかと、どう直すか"}
   }
  }
 }
}
