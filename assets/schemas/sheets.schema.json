{
 "title": "照合に出した版の記録",
 "file": "review/sheets.json",
 "description": "照合に出すたびに、機械が書き足す（業務フローは make_compare.py、アクティビティ図は review.py record。前の版の採否表を認めるときは review.py snapshot --assume-current）。手で書かない・消さない。どの報告がどの版の図を照合したかは、報告の sheet とこの記録で決まる",
 "type": "object",
 "additionalProperties": false,
 "required": ["sheets"],
 "properties": {
  "sheets": {"type": "array", "items": {"$ref": "#/$defs/sheet"}, "description": "照合に出した順"}
 },
 "$defs": {
  "sheet": {
   "title": "sheets[]",
   "type": "object",
   "additionalProperties": false,
   "required": ["id", "date", "kind", "figure", "mark", "nodes"],
   "properties": {
    "id": {"$ref": "common#/$defs/sheet_id", "description": "シートの番号（1 回に出した図は、同じ番号）"},
    "date": {"type": "string", "description": "照合に出した日"},
    "kind": {"enum": ["全体", "差分", "認めた"], "description": "全体の照合／差分照合（照合のあとに変わった箱だけ）／利用者が、いまの図を照合済みと認めた（前の版の採否表）"},
    "figure": {"$ref": "common#/$defs/figure_id", "description": "図の番号"},
    "mark": {"$ref": "common#/$defs/mark", "description": "照合に出したときの図のデータの印。採用した指摘の図が、まだこの印のままなら、反映していない"},
    "nodes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/seen"}, "description": "箱の番号 → 照合に出したときの要約（差分照合は、照合し直す箱だけ）"},
    "reports": {"type": "object", "additionalProperties": {"$ref": "common#/$defs/mark"}, "description": "認めた版だけ: 認めた前の版の報告（ファイル名 → 中身の印）"}
   }
  },
  "seen": {
   "title": "sheets[].nodes{}",
   "type": "object",
   "additionalProperties": false,
   "required": ["type", "label", "lane", "detail", "inferred", "link", "pages", "edges"],
   "properties": {
    "type": {"type": "string", "description": "種類"},
    "label": {"type": "string", "description": "名前"},
    "lane": {"type": "string", "description": "レーンの名前"},
    "detail": {"type": "string", "description": "補足"},
    "inferred": {"type": "boolean", "description": "推定の印"},
    "link": {"type": "string", "description": "リンク先の図"},
    "pages": {"type": "array", "items": {"type": "string"}, "description": "出典（資料 ID・ページ・行の範囲）"},
    "edges": {"type": "array", "items": {"type": "string"}, "description": "前後の線（→行き先・←もと と、ラベル・推定の印）"},
    "systems": {"type": "string", "description": "使うシステムの札"},
    "direction": {"type": "string", "description": "帳票の向き（in・out）"},
    "attach_to": {"type": "string", "description": "帳票の付く箱"},
    "calls": {"type": "string", "description": "アクティビティ図: まとめた呼び出し"},
    "loop": {"type": "string", "description": "アクティビティ図: 繰り返し"},
    "folded": {"type": "string", "description": "アクティビティ図: 畳んだ手続き"}
   }
  }
 }
}
