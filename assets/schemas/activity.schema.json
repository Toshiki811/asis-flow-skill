{
 "title": "アクティビティ図のデータ",
 "file": "activities/<番号>.activity.json（activity.py apply が書く。手で直さない）",
 "type": "object",
 "additionalProperties": false,
 "required": ["flow_id", "name", "kind", "system", "project", "procedure", "scope", "tier", "lanes", "nodes", "edges", "lines", "branches", "questions"],
 "properties": {
  "flow_id": {"$ref": "common#/$defs/activity_id", "description": "アクティビティ図の番号（A-<システムの番号>-<連番>）"},
  "name": {"type": "string", "minLength": 1, "description": "図の名前（直しの一覧の `name`。業務フローの起動点の箱のラベルになる）"},
  "number": {"type": "string"},
  "kind": {"enum": ["entry", "shared"], "description": "`entry` 起動点の処理／`shared` ほかの処理から呼ばれる共通の処理"},
  "system": {"type": "object", "description": "システムの番号と名前"},
  "project": {"type": "string", "description": "プログラムのまとまりの id"},
  "entry": {"type": ["string", "null"], "description": "起動点（M05.e2）。共通の処理は null"},
  "trigger": {"type": "string", "description": "起動方法（ボタン・イベント・バッチなど、プログラムの起動のしかた）"},
  "procedure": {"type": "string", "description": "もとの手続き"},
  "scope": {"type": "array", "items": {"type": "string"}, "description": "この図に入っている手続き（呼ぶ側に入れた手続きを含む）"},
  "tier": {"enum": ["parsed", "heuristic", "llm"], "description": "構造の取り出し方"},
  "summary": {"type": "string"},
  "lanes": {"type": "array", "minItems": 1, "items": {"type": "object"}, "description": "操作者／プログラム（システム名）／外部"},
  "nodes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/node"}},
  "edges": {"type": "array", "items": {"type": "object"}},
  "lines": {"type": "array", "items": {"type": "object"}, "description": "実行文の行の持ち主: どの箱に入ったか、対象外か（理由つき）。行の網羅の点検に使う"},
  "branches": {"type": "array", "items": {"type": "object"}, "description": "分岐・繰り返しの扱い: 判断／繰り返す箱／畳んだ（理由つき）／先に図にする文が無い"},
  "questions": {"type": "array", "items": {"$ref": "common#/$defs/question"}}
 },
 "$defs": {
  "node": {
   "title": "nodes[]",
   "type": "object",
   "additionalProperties": false,
   "required": ["id", "type", "lane", "label"],
   "properties": {
    "id": {"$ref": "common#/$defs/node_id"},
    "type": {"enum": ["start", "end", "process", "decision", "system", "file", "subprocess"]},
    "lane": {"type": "string"},
    "label": {"type": "string"},
    "detail": {"type": "string"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "attach_to": {"type": "string"},
    "direction": {"enum": ["in", "out"]},
    "link_flow": {"type": "string", "description": "呼び出しの箱: 呼ぶ先のアクティビティ図の番号"},
    "loop": {"type": "string", "description": "繰り返す箱: 繰り返しの条件（ソースの文字。図には出さず、一覧の「プログラムのノード一覧」に出る）"},
    "folded": {"type": "string", "description": "畳んだ箱: 畳んだ理由"},
    "calls": {
     "type": "array",
     "description": "同じ共通の処理を続けて呼ぶ並びを、1つにまとめた箱: 呼ぶ先の図と、回数",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "times"],
      "properties": {
       "to": {"type": "string", "description": "呼ぶ先のアクティビティ図の番号"},
       "times": {"type": "integer", "description": "この箱の中で呼ぶ回数"},
       "label": {"type": "string", "description": "呼ぶ先の図の名前"}
      }
     }
    },
    "unnamed": {"type": "boolean", "description": "名前がまだ付いていない箱（点検が FAIL にする）"}
   }
  },
  "source": {
   "title": "nodes[].sources[]（出典）",
   "type": "object",
   "additionalProperties": false,
   "required": ["doc_id", "page", "lines", "quote", "from_image"],
   "properties": {
    "doc_id": {"$ref": "common#/$defs/doc_id", "description": "資料 ID"},
    "page": {"type": "integer", "minimum": 1, "description": "ソースのページ（ファイル名 pNNNN の番号）"},
    "lines": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2, "description": "ページの中の行の番号 [開始, 終了]"},
    "quote": {"type": "string", "description": "先頭の行の文字（機械が写す）"},
    "from_image": {"type": "boolean"}
   }
  }
 }
}
