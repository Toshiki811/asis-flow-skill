{
 "title": "ページの機械抽出",
 "file": "pages/<資料ID>/pNNNN.json（スクリプトが書く）",
 "type": "object",
 "required": ["doc_id", "page", "label", "kind", "text"],
 "properties": {
  "doc_id": {"$ref": "common#/$defs/doc_id"},
  "page": {"type": "integer", "minimum": 1},
  "label": {"type": "string"},
  "kind": {"enum": ["page", "slide", "sheet", "vba", "code", "image", "text"]},
  "text": {"type": "array", "items": {"type": "string"}},
  "cells": {"type": "array", "items": {"type": "string"}},
  "cell_at": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
  "printed_candidates": {"type": "array", "items": {"type": "object", "required": ["n", "x", "y"]}},
  "align": {"type": "number"},
  "misaligned": {"type": "boolean"},
  "images": {"type": "integer"},
  "code": {
   "type": "object",
   "required": ["language", "module", "line_from"],
   "properties": {
    "language": {"type": "string"},
    "module": {"type": "string"},
    "module_kind": {"type": "string"},
    "line_from": {"type": "integer", "minimum": 1},
    "sheet": {"type": "string"},
    "secrets": {"type": "array", "items": {"type": "integer"}},
    "part": {"enum": ["code"], "description": "コードだけのファイル（Access の書き出し）"}
   },
   "additionalProperties": false
  },
  "doc_name": {"type": "string", "description": "資料のファイル名"},
  "line_from": {"type": "integer", "minimum": 1, "description": "文字のファイル・ソース: このページの先頭の行の番号"},
  "links": {"type": "array", "items": {"type": "string"}, "description": "PDF のリンク先"},
  "size_pt": {"type": "array", "items": {"type": "number"}, "description": "ページの大きさ（ポイント）"},
  "zoom": {"type": "number", "description": "画像の倍率"},
  "no_text_layer": {"type": "boolean", "description": "文字の層が無い（スキャン）"},
  "small_text": {"type": "boolean", "description": "字が小さい（拡大して読む）"},
  "small_chars": {"type": "integer", "description": "小さい字の数"},
  "suggest_grid": {"type": "array", "items": {"type": "integer"}, "description": "拡大して読むときの分け方（横・縦）"},
  "drawings": {"type": "object", "description": "線で描いた図の数 {line, curve, rect}"},
  "vector_figure": {"type": "boolean", "description": "線で描いた図がある"},
  "render": {"type": "object", "description": "描画に使った PDF {pdf, pdf_page}"},
  "title": {"type": "string", "description": "スライドの題名"},
  "shapes": {"type": "array", "items": {"type": "object"}, "description": "図形 {id, name, type, text, bbox / cell}"},
  "connectors": {"type": "array", "items": {"type": "object"}, "description": "コネクタ {id, from, to}"},
  "tables": {"type": "array", "description": "スライドの表（行の並び）"},
  "pictures": {"type": "integer", "description": "貼られた画像の数"},
  "charts": {"type": "integer", "description": "グラフの数"},
  "notes": {"type": "string", "description": "スライドのノート"},
  "hidden": {"type": "boolean", "description": "非表示のシート・スライド"},
  "sheet": {"type": "string", "description": "シートの名前"}
 },
 "additionalProperties": false
}
