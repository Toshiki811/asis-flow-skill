{
 "title": "原典照合レビューの採否表",
 "file": "review/<フローID>.review.json",
 "type": "object",
 "additionalProperties": false,
 "required": ["flow_id", "verdicts", "findings"],
 "properties": {
  "flow_id": {"$ref": "common#/$defs/figure_id", "description": "フローの id か、アクティビティ図の番号"},
  "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}, "description": "ノードごとの判定（開始・終了を除く全ノード）"},
  "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}, "description": "指摘と採否。指摘が無ければ空"},
  "reviewed": {"$ref": "#/$defs/reviewed", "description": "照合した版の写し（review.py draft が書く。手で書かない）。いまの図と違う箱は、照合していない箱として点検が FAIL にする。無ければ前の版の採否表（点検は WARN）"}
 },
 "$defs": {
  "verdict": {
   "title": "verdicts[]",
   "type": "object",
   "additionalProperties": false,
   "required": ["node", "verdict", "evidence"],
   "properties": {
    "node": {"$ref": "common#/$defs/node_id", "description": "ノード番号"},
    "verdict": {"enum": ["支持", "一部支持", "不支持"], "description": "レビュー担当の判定"},
    "evidence": {"type": "string", "description": "原典の該当箇所の引用と、違う点"}
   }
  },
  "reviewed": {
   "title": "reviewed",
   "type": "object",
   "additionalProperties": false,
   "required": ["nodes", "reports", "figures"],
   "properties": {
    "nodes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/seen"}, "description": "ノード番号 → 照合したときの要約"},
    "reports": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{12}$"}, "description": "写しを取ったときの照合の報告（ファイル名 → 中身の印）。新しい報告・変わった報告が見た箱だけ、写しを取り直す"},
    "figures": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{12}$"}, "description": "報告ごとの、その報告を受けたときの図のデータの印。採用した指摘の図が、まだこの印のままなら、反映していない（点検が FAIL）。snapshot --assume-current では空（反映済みと認める）"},
    "assumed": {"type": "string", "description": "review.py snapshot --assume-current で、いまの図を照合済みとして写した日（利用者が認めた）"}
   }
  },
  "seen": {
   "title": "reviewed.nodes{}",
   "type": "object",
   "additionalProperties": false,
   "required": ["type", "label", "lane", "detail", "inferred", "link", "pages", "edges"],
   "properties": {
    "type": {"type": "string", "description": "種類"},
    "label": {"type": "string", "description": "名前"},
    "lane": {"type": "string", "description": "レーンの名前"},
    "detail": {"type": "string", "description": "補足"},
    "inferred": {"type": "boolean", "description": "推定の印"},
    "link": {"type": "string", "description": "リンク先の図"},
    "pages": {"type": "array", "items": {"type": "string"}, "description": "出典のページ（資料 ID とページ）"},
    "edges": {"type": "array", "items": {"type": "string"}, "description": "前後の線（→行き先・←もと と、ラベル）"}
   }
  },
  "finding": {
   "title": "findings[]",
   "type": "object",
   "additionalProperties": false,
   "required": ["id", "kind", "target", "text", "decision", "action"],
   "properties": {
    "id": {"type": "string", "pattern": "^r[0-9]+$", "description": "r1、r2…"},
    "kind": {
     "enum": ["一部支持", "不支持", "抜け", "つなぎ", "表記", "名前が違う", "していないことを書いている", "条件・出口が逆", "流れが違う", "読む・書くが違う", "落ちている処理", "図にしない理由が違う", "as-is でない"],
     "description": "業務フロー: `抜け` ページにあるのにフローに無い／`つなぎ` 順序・分岐・担当の誤り。アクティビティ図: 照合の報告の種類（名前が違う／していないことを書いている／条件・出口が逆／流れが違う／読む・書くが違う／落ちている処理／図にしない理由が違う／as-is でない）"
    },
    "target": {"type": "string", "description": "ノード・線・ページ（照合シートの見出しの書き方で）"},
    "text": {"type": "string", "minLength": 1, "description": "指摘（レビュー担当の原文のまま）"},
    "decision": {"enum": ["採用", "不採用", "保留"], "description": "採否"},
    "action": {"type": "string", "minLength": 1, "description": "採用なら何を直したか。不採用・保留なら理由"}
   }
  }
 }
}
