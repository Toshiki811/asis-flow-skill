{
 "title": "フロー化の報告",
 "file": "reports/flow_<フローID>.json",
 "type": "object",
 "additionalProperties": false,
 "required": ["flow_id", "status", "nodes", "inferred", "questions_high", "for_parent", "split_proposal"],
 "properties": {
  "flow_id": {"$ref": "common#/$defs/flow_id", "description": "フロー id"},
  "status": {"enum": ["done", "split_needed"], "description": "`done` 書いた／`split_needed` 材料が大きすぎるので書かずに分割案を返す"},
  "nodes": {"type": "integer", "minimum": 0, "description": "ノードの数"},
  "inferred": {"type": "integer", "minimum": 0, "description": "推定で置いた数"},
  "questions_high": {"type": "array", "items": {"type": "string"}, "description": "重要度 高 の確認事項の問い（1件1行）"},
  "for_parent": {"type": "array", "items": {"type": "string"}, "description": "親に決めてほしいこと（担当名の食い違い・続き先・用語の正本に無い名前）。1件1行"},
  "split_proposal": {
   "type": "array",
   "description": "分割案（`split_needed` のとき）。原典の節・項の切れ目で分ける",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "pages", "reason"],
    "properties": {
     "name": {"type": "string", "minLength": 1},
     "pages": {"type": "array", "items": {"$ref": "common#/$defs/page_set"}},
     "reason": {"type": "string"}
    }
   }
  }
 }
}
